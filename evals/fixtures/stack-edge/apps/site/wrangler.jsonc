{
  "name": "site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "www.example-co.com/*", "zone_name": "example-co.com" }],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "services": [{ "binding": "API", "service": "edge-api", "entrypoint": "OrdersRpc" }],
  "vars": { "SENTRY_DSN": "https://0123456789abcdef0123456789abcdef@o123456.ingest.de.sentry.io/1234567" }
}
