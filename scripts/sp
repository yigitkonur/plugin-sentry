#!/usr/bin/env bash
# sp: switch the sentry plugin on or off for ONE project, in Claude Code and in Codex.
#   sp on [dir] [--trust]   enable here (Claude: project scope, or local scope when the repo tracks .claude/settings.json;
#                           Codex: <dir>/.codex/config.toml, which Codex reads only for a trusted project, so add --trust)
#   sp off [dir]            disable here
#   sp status [dir]         on or off here, per host
# The plugin stays installed globally but disabled, so it costs no tokens anywhere it is off.
# Not part of the plugin: its own bin/ is not on PATH while it is off. Copy this file and codex-plugin-project.sh to a folder on PATH (for example ~/.local/bin).
set -u
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
P="sentry@plugin-sentry"
cmd="${1:-status}"; shift 2>/dev/null; dir="$PWD"; trust=""
for a in "$@"; do case "$a" in --trust) trust="--trust" ;; *) dir="$a" ;; esac; done
cd "$dir" 2>/dev/null || { echo "sp: no such folder: $dir" >&2; exit 2; }
HAVE_CLAUDE=0; command -v claude >/dev/null 2>&1 && HAVE_CLAUDE=1
HAVE_CODEX=0; PROJ="$(command -v codex-plugin-project.sh 2>/dev/null || echo "$(dirname "$0")/codex-plugin-project.sh")"
command -v codex >/dev/null 2>&1 && [ -x "$PROJ" ] && HAVE_CODEX=1
[ "$HAVE_CLAUDE$HAVE_CODEX" = "00" ] && { echo "sp: neither claude nor codex (with codex-plugin-project.sh) found on PATH" >&2; exit 2; }

scope=project; file=.claude/settings.json
if git ls-files --error-unmatch .claude/settings.json >/dev/null 2>&1; then scope=local; file=.claude/settings.local.json; fi

state() {  # prints on, off or not-installed for this folder
  claude plugin list --json 2>/dev/null | python3 -c '
import sys, json, os
here = os.path.realpath(os.getcwd())
rows = [p for p in json.load(sys.stdin) if p["id"] == "'$P'"]
if not rows: print("not-installed"); sys.exit()
on = any(p["enabled"] for p in rows if p["scope"] == "user" or os.path.realpath(p.get("projectPath") or "/nonexistent") == here)
print("on" if on else "off")'
}

ensure_installed() {
  [ "$(state)" = "not-installed" ] || return 0
  echo "sp: not installed yet, installing globally (disabled)"
  claude plugin install sentry --marketplace yigitkonur/plugin-sentry >/dev/null 2>&1 || { echo "sp: install failed" >&2; exit 1; }
  claude plugin disable "$P" --scope user >/dev/null 2>&1
}

codex_state() { codex plugin list 2>/dev/null | awk -F'  +' '$1=="sentry@plugin-sentry"{print $2; exit}'; }

codex_ensure_installed() {
  case "$(codex_state)" in installed*) return 0 ;; esac
  echo "sp: codex: not installed yet, installing globally (disabled)"
  codex plugin marketplace add yigitkonur/plugin-sentry >/dev/null 2>&1
  codex plugin add sentry@plugin-sentry >/dev/null 2>&1 || { echo "sp: codex install failed" >&2; return 1; }
  "$PROJ" global-off sentry@plugin-sentry >/dev/null
}

case "$cmd" in
  on)
    if [ "$HAVE_CLAUDE" = 1 ]; then
      ensure_installed
      claude plugin enable "$P" --scope "$scope" || exit 1
      # keep the settings file out of `git add -A` without touching tracked files
      if git rev-parse --git-dir >/dev/null 2>&1 && ! git check-ignore -q "$file" 2>/dev/null; then
        ex=$(git rev-parse --git-path info/exclude); mkdir -p "$(dirname "$ex")"
        grep -qxF "$file" "$ex" 2>/dev/null || echo "$file" >> "$ex"
      fi
      echo "sp: claude: on in $PWD ($scope scope). Run /reload-plugins in an open claude here, or start claude, then /sentry:start."
    fi
    if [ "$HAVE_CODEX" = 1 ]; then
      codex_ensure_installed && "$PROJ" on "$P" "$PWD" $trust && echo "sp: codex: on in $PWD. Start a new codex here; the first time it asks you to review the plugin's hooks (t = trust all)."
    fi
    ;;
  off)
    [ "$HAVE_CLAUDE" = 1 ] && { claude plugin disable "$P" --scope "$scope" || exit 1; echo "sp: claude: off in $PWD ($scope scope). Run /reload-plugins in an open claude here, or restart it."; }
    [ "$HAVE_CODEX" = 1 ] && { "$PROJ" off "$P" "$PWD" && echo "sp: codex: off in $PWD. Start a new codex here."; }
    ;;
  status)
    [ "$HAVE_CLAUDE" = 1 ] && echo "sp: claude: $(state) in $PWD"
    [ "$HAVE_CODEX" = 1 ] && echo "sp: codex: $(codex_state | sed 's/^$/not installed/') in $PWD"
    ;;
  *)
    echo "usage: sp on|off|status [dir] [--trust]" >&2; exit 2 ;;
esac
