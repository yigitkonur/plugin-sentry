{
 "js": {
  "label": "JavaScript / TypeScript",
  "manifests": [
   "package.json"
  ],
  "lockfiles": [
   "package-lock.json",
   "npm-shrinkwrap.json",
   "pnpm-lock.yaml",
   "yarn.lock",
   "bun.lock",
   "bun.lockb"
  ],
  "sdk_prefixes": [
   "@sentry/"
  ],
  "sdk_exact": [
   "toucan-js",
   "@hono/sentry",
   "sentry-expo",
   "@sentry-internal/"
  ],
  "legacy": {
   "raven-js": "replaced by @sentry/browser",
   "raven": "replaced by @sentry/node",
   "@sentry/tracing": "merged into the SDK since v8",
   "@sentry/hub": "removed in v8",
   "@sentry/integrations": "merged in v8",
   "@sentry/minimal": "removed in v8",
   "@sentry/types": "merged into @sentry/core",
   "@sentry/replay": "merged into @sentry/browser",
   "sentry-expo": "retired; use @sentry/react-native",
   "toucan-js": "deprecated; use @sentry/cloudflare",
   "@hono/sentry": "deprecated; use @sentry/hono"
  },
  "src_exts": [
   ".js",
   ".jsx",
   ".ts",
   ".tsx",
   ".mjs",
   ".cjs",
   ".mts",
   ".cts",
   ".vue",
   ".svelte",
   ".astro"
  ],
  "init_patterns": [
   "\\bSentry\\.init\\s*\\(",
   "\\bwithSentry\\s*\\(",
   "\\bsentryPagesPlugin\\b",
   "\\bdefineCloudflareOptions\\b",
   "\\binstrumentDurableObjectWithSentry\\b",
   "\\bSentry\\.wrap\\s*\\(",
   "\\bsetupSentry\\w*\\s*\\("
  ],
  "config_names": [
   "instrumentation.ts",
   "instrumentation.js",
   "instrumentation-client.ts",
   "instrumentation-client.js",
   "sentry.client.config.*",
   "sentry.server.config.*",
   "sentry.edge.config.*",
   "instrument.js",
   "instrument.mjs",
   "instrument.cjs",
   "instrument.ts",
   "instrument.server.*",
   "instrument.client.*",
   "instrumentation.server.*",
   ".sentryclirc",
   ".env.sentry-build-plugin",
   "sentry.properties"
  ],
  "bundled": true,
  "compiled": false
 },
 "python": {
  "label": "Python",
  "manifests": [
   "pyproject.toml",
   "requirements.txt",
   "requirements-*.txt",
   "requirements.in",
   "Pipfile",
   "setup.py",
   "setup.cfg"
  ],
  "lockfiles": [
   "uv.lock",
   "poetry.lock",
   "Pipfile.lock",
   "pdm.lock",
   "requirements.txt"
  ],
  "sdk_prefixes": [
   "sentry-sdk",
   "sentry_sdk"
  ],
  "sdk_exact": [],
  "legacy": {
   "raven": "replaced by sentry-sdk"
  },
  "src_exts": [
   ".py"
  ],
  "init_patterns": [
   "\\bsentry_sdk\\.init\\s*\\(",
   "\\binit_sentry\\s*\\("
  ],
  "config_names": [
   "sentry.properties",
   ".sentryclirc"
  ],
  "bundled": false,
  "compiled": false
 },
 "go": {
  "label": "Go",
